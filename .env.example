# Database (Neon) — https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth (Better Auth)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption for at-rest secrets (users' Gemini API keys). REQUIRED.
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# File Storage (Vercel Blob — auto-injected when you connect Blob in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# ── AI Provider Config ────────────────────────────────────────────────────────
# Parsed runs on Google Gemini. Each user adds their OWN Gemini API key in
# Settings, which powers their embeddings + generation. The env key below is an
# optional shared fallback for users who haven't added one.
# LLM_PROVIDER options:    anthropic | openai | google | ollama
# EMBEDDING_PROVIDER options: openai | google | ollama
# Model names are optional — each provider has a sensible default.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

# ── AI API Keys ───────────────────────────────────────────────────────────────
# Optional shared fallback key — used only when a user hasn't set their own.
# GOOGLE_GENERATIVE_AI_API_KEY=    # https://aistudio.google.com → Get API Key
# OPENAI_API_KEY=                  # https://platform.openai.com → API Keys
# ANTHROPIC_API_KEY=               # https://console.anthropic.com → API Keys

# Jina AI — reranks retrieved chunks before sending to LLM (improves answer quality)
# Free tier: 1M tokens/month — https://jina.ai → Get API Key
# Optional: if unset, top similarity results are used directly without reranking.
# JINA_API_KEY=

# Vector DB (Pinecone) — https://pinecone.io
# Create index: name=parsed, dims=768 (google) or 1536 (openai), metric=cosine
PINECONE_API_KEY=
PINECONE_INDEX_NAME=parsed

# Google OAuth (optional — only needed for "Sign in with Google")
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) — https://resend.com → API Keys
RESEND_API_KEY=

# Inngest — https://app.inngest.com → Your App → API Keys
# Leave blank for local dev (Inngest dev server handles it automatically)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Pusher — https://dashboard.pusher.com → Channels → Your App → App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
